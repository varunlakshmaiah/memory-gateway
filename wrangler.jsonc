// Deployable defaults, used by `npm run setup` and the Deploy to Cloudflare button.
// Resources without an ID (D1, buckets, queue) are created on the first deploy.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "memory-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "observability": { "enabled": true },
  // Public URL stays on workers.dev; preview URLs per version are off so old versions are not reachable.
  "workers_dev": true,
  "preview_urls": false,

  "vars": {
    // Set to "<vaultName>/" if Remotely Save stores your notes under a vault-name folder.
    // Check your bucket in the Cloudflare dashboard. Leave empty if notes sit at the bucket root.
    "VAULT_PREFIX": "",
    // The only folder agents may write to.
    "WRITE_PREFIX": "inbox/agents/",
    // Which agents may revise existing notes with edit_note, by folder prefix ("" = whole vault).
    // JSON as a string, e.g. {"claude":["projects/","notes/"]}. "{}" = nobody (default).
    // core/ and notes with `locked: true` are never editable; edits need the BACKUP bucket for undo.
    "EDIT_POLICY": "{}",
    "MAX_NOTE_BYTES": "200000",
    "BACKUP_KEEP_DAYS": "14"
  },

  "r2_buckets": [
    // The bucket Remotely Save syncs your vault to.
    { "binding": "VAULT", "bucket_name": "obsidian-vault" },
    // Daily snapshots and edit history. Must be a SECOND bucket, never the synced one.
    { "binding": "BACKUP", "bucket_name": "obsidian-vault-backup" }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "memory-gateway-index"
    }
  ],

  // Search by meaning (npm run setup creates the index). Remove both lines for keyword-only search.
  "ai": { "binding": "AI" },
  "vectorize": [{ "binding": "VEC", "index_name": "memory-gateway-notes" }],

  "queues": {
    "consumers": [
      { "queue": "vault-events", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 5 }
    ]
  },

  "triggers": { "crons": ["17 3 * * *"] }
}
