# Copy to .dev.vars for local development (wrangler dev). Never commit .dev.vars.
# Tokens must be at least 16 characters. Generate with: openssl rand -hex 24
AGENT_TOKENS={"claude":"local-dev-token-claude-0123456789","hermes":"local-dev-token-hermes-0123456789"}
ADMIN_TOKEN=local-dev-admin-token-0123456789
# Vectorize cannot run in local dev; search falls back to keywords only.
SEMANTIC_SEARCH=off
