# Secrets. The Deploy to Cloudflare button asks for these; for local dev see README "Try it locally first".
# AGENT_TOKENS: JSON of agent name -> token, e.g. {"claude":"<token>","hermes":"<token>"}.
# Generate each token with: openssl rand -hex 24  (tokens under 16 characters are refused)
AGENT_TOKENS={"claude":"CHANGE_ME"}
ADMIN_TOKEN=CHANGE_ME
